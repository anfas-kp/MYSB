# ==============================================================================
# MYSB Program Landing Page - Environment Variables
# ==============================================================================
# Copy this file to .env or configure these variables in Vercel / Netlify dashboard.

# --- 01. Program & Cohort Settings ---
TOTAL_SEATS=10
SEATS_REMAINING=4
FORCE_WAITLIST_MODE=false

# --- 02. Community & Contact URLs ---
# [WHATSAPP LINK]: Official MYSB WhatsApp group invite URL
WHATSAPP_GROUP_INVITE_URL=https://chat.whatsapp.com/YOUR_GROUP_INVITE_CODE
OPERATIONS_EMAIL=hello@mysbprogram.org
TECHNICAL_OWNER=Anfas KP

# --- 03. Google Sheets Integration ---
# (Option A) Google Apps Script Webhook URL or SheetDB API URL
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# --- 04. Airtable Integration (Optional) ---
# (Option B) Airtable Personal Access Token (PAT) & Base
AIRTABLE_API_KEY=pat_your_airtable_access_token_here
AIRTABLE_BASE_ID=appYourBaseIdHere
AIRTABLE_TABLE_NAME=Registrations

# --- 05. Email Delivery (Resend API) ---
# Sign up at https://resend.com for 3,000 free emails/month
RESEND_API_KEY=re_your_resend_api_key_here

# --- 06. Video Embed ---
# [VIDEO URL]: Unlisted YouTube or Vimeo video embed link
VIDEO_EMBED_URL=https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ
